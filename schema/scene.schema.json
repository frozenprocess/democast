{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "democast scene",
  "type": "object",
  "required": [
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "output file prefix (default: the file name)"
    },
    "site": {
      "type": "string",
      "description": "loaded into the browser panel at the start"
    },
    "siteLabel": {
      "type": "string",
      "description": "what the fake URL bar shows"
    },
    "autoFocus": {
      "type": "boolean"
    },
    "layout": {
      "enum": [
        "focus",
        "both",
        "max"
      ]
    },
    "formats": {
      "type": "array",
      "items": {
        "enum": [
          "16x9",
          "1x1",
          "4x5",
          "9x16"
        ]
      }
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "description": "frame rate (default 30); --fps overrides it"
    },
    "timeout": {
      "type": "number",
      "minimum": 0,
      "description": "default per-step timeout, ms"
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number"
        ]
      }
    },
    "browser": {
      "type": "object",
      "properties": {
        "scale": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "16x9",
                  "1x1",
                  "4x5",
                  "9x16"
                ]
              },
              "additionalProperties": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          ]
        },
        "profile": {
          "type": "string",
          "pattern": "^[\\w.-]+$",
          "description": "a profile saved with democast login"
        },
        "loginUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ],
          "description": "where democast login opens (default: site); a list opens several tabs"
        },
        "auth": {
          "type": "object",
          "properties": {
            "username": {
              "type": [
                "string",
                "number"
              ]
            },
            "password": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "username",
            "password"
          ]
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "blur": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "saveSession": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "terminal": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "fontSize": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "16x9",
                  "1x1",
                  "4x5",
                  "9x16"
                ]
              },
              "additionalProperties": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          ]
        },
        "cps": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "terminal2": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "stage CSS colors"
    },
    "voice": {
      "$ref": "#/$defs/voice"
    },
    "music": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "volume": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "file"
          ]
        }
      ]
    },
    "redact": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "enum": [
              "email",
              "tailnet",
              "tailscale-ip",
              "tailscale-ipv6",
              "keys"
            ]
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "with": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "ignoreCase": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "text"
            ]
          },
          {
            "type": "object",
            "properties": {
              "regex": {
                "type": "string"
              },
              "with": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "ignoreCase": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "regex"
            ]
          }
        ]
      }
    },
    "noBlur": {
      "type": "boolean"
    },
    "remix": {
      "type": "boolean"
    },
    "takes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "remix: short names for takes"
    },
    "setup": {
      "$ref": "#/$defs/steps"
    },
    "teardown": {
      "$ref": "#/$defs/steps",
      "description": "run after each take, even a failed one, off camera: e.g. delete what the scene created"
    },
    "steps": {
      "$ref": "#/$defs/steps"
    }
  },
  "$defs": {
    "voice": {
      "type": "object",
      "properties": {
        "engine": {
          "enum": [
            "kokoro",
            "vibevoice",
            "command"
          ],
          "description": "default kokoro"
        },
        "voice": {
          "type": "string",
          "description": "voice name for the engine, e.g. am_michael (kokoro) or Carter (vibevoice)"
        },
        "command": {
          "type": "string",
          "description": "command engine: reads the text on stdin, writes a WAV to {out}"
        },
        "pronounce": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "respellings used only for speech"
        },
        "volume": {
          "type": "number",
          "minimum": 0
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "kokoro"
        },
        "lang": {
          "type": "string",
          "description": "kokoro: en-us, en-gb, fr-fr, ja, cmn, ..."
        },
        "model": {
          "enum": [
            "fp32",
            "int8"
          ],
          "description": "kokoro"
        },
        "device": {
          "type": "string",
          "description": "vibevoice: cuda or cpu"
        },
        "dtype": {
          "type": "string",
          "description": "vibevoice: bfloat16, float16 or float32"
        },
        "cfg": {
          "type": "number",
          "description": "vibevoice guidance scale"
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "description": "vibevoice diffusion steps"
        }
      },
      "additionalProperties": false,
      "description": "narration voice"
    },
    "selectorArg": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "selector": {
              "type": "string"
            },
            "timeout": {
              "type": "number",
              "minimum": 0,
              "description": "ms, for this step (same as the step's own timeout)"
            }
          },
          "additionalProperties": false,
          "required": [
            "selector"
          ]
        }
      ]
    },
    "step": {
      "type": "object",
      "description": "one action, plus an optional timeout",
      "properties": {
        "wait": {
          "type": "number",
          "minimum": 0,
          "description": "pause, ms"
        },
        "say": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "wait": {
                  "type": "boolean"
                },
                "voice": {
                  "$ref": "#/$defs/voice"
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ms, for this step (same as the step's own timeout)"
                }
              },
              "additionalProperties": false,
              "required": [
                "text"
              ]
            }
          ],
          "description": "speak a line of narration"
        },
        "card": {
          "type": "object",
          "properties": {
            "image": {
              "type": "string"
            },
            "title": {
              "type": [
                "string",
                "number"
              ]
            },
            "sub": {
              "type": [
                "string",
                "number"
              ]
            },
            "link": {
              "type": [
                "string",
                "number"
              ]
            },
            "pills": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "footer": {
              "type": [
                "string",
                "number"
              ]
            },
            "timeout": {
              "type": "number",
              "minimum": 0,
              "description": "ms, for this step (same as the step's own timeout)"
            }
          },
          "additionalProperties": false,
          "description": "full-screen title card"
        },
        "hideCard": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "minShown": {
                  "type": "number",
                  "minimum": 0
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ms, for this step (same as the step's own timeout)"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "caption": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": [
                "string",
                "number"
              ]
            },
            {
              "type": "object",
              "properties": {
                "text": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "sub": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ms, for this step (same as the step's own timeout)"
                }
              },
              "additionalProperties": false
            }
          ],
          "description": "caption above the panels; \"\" clears it"
        },
        "cursor.hide": {
          "type": "null"
        },
        "focus": {
          "enum": [
            "browser",
            "term"
          ]
        },
        "view": {
          "enum": [
            "browser",
            "term",
            "both"
          ]
        },
        "browser.open": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ms, for this step (same as the step's own timeout)"
                }
              },
              "additionalProperties": false,
              "required": [
                "url"
              ]
            }
          ]
        },
        "browser.waitFor": {
          "anyOf": [
            {
              "type": "string",
              "description": "a JS condition"
            },
            {
              "type": "object",
              "properties": {
                "selector": {
                  "type": "string"
                },
                "text": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "js": {
                  "type": "string"
                },
                "reload": {
                  "type": "integer",
                  "minimum": 0
                },
                "each": {
                  "type": "number",
                  "minimum": 0
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ms, for this step (same as the step's own timeout)"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "browser.click": {
          "$ref": "#/$defs/selectorArg"
        },
        "browser.type": {
          "type": "object",
          "properties": {
            "selector": {
              "type": "string"
            },
            "text": {
              "type": [
                "string",
                "number"
              ]
            },
            "cps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "clear": {
              "type": "boolean"
            },
            "timeout": {
              "type": "number",
              "minimum": 0,
              "description": "ms, for this step (same as the step's own timeout)"
            },
            "seed": {
              "type": "integer",
              "description": "type with the same rhythm on every take"
            }
          },
          "additionalProperties": false,
          "required": [
            "text"
          ]
        },
        "browser.fill": {
          "type": "object",
          "properties": {
            "selector": {
              "type": "string"
            },
            "text": {
              "type": [
                "string",
                "number"
              ]
            },
            "timeout": {
              "type": "number",
              "minimum": 0,
              "description": "ms, for this step (same as the step's own timeout)"
            }
          },
          "additionalProperties": false,
          "required": [
            "selector",
            "text"
          ]
        },
        "browser.press": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "times": {
                  "type": "integer",
                  "minimum": 1
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ms, for this step (same as the step's own timeout)"
                }
              },
              "additionalProperties": false,
              "required": [
                "key"
              ]
            }
          ]
        },
        "browser.waitQuiet": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "object",
              "properties": {
                "ms": {
                  "type": "number",
                  "minimum": 0
                },
                "selector": {
                  "type": "string"
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ms, for this step (same as the step's own timeout)"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "browser.highlight": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "text": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "selector": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ms, for this step (same as the step's own timeout)"
                }
              },
              "additionalProperties": false,
              "required": [
                "text"
              ]
            }
          ]
        },
        "browser.unhighlight": {
          "type": "null"
        },
        "browser.scrollTo": {
          "$ref": "#/$defs/selectorArg"
        },
        "browser.blur": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "properties": {
                "selector": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ms, for this step (same as the step's own timeout)"
                }
              },
              "additionalProperties": false,
              "required": [
                "selector"
              ]
            }
          ]
        },
        "browser.unblur": {
          "type": "null"
        },
        "browser.eval": {
          "type": "string"
        },
        "browser.popup": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "click": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "unless": {
                  "type": "string"
                },
                "trigger": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ms, for this step (same as the step's own timeout)"
                }
              },
              "additionalProperties": false,
              "required": [
                "click"
              ]
            }
          ]
        },
        "browser.showPopup": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ms, for this step (same as the step's own timeout)"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "browser.showMain": {
          "type": "null"
        },
        "browser.capture": {
          "type": "object",
          "properties": {
            "var": {
              "type": "string"
            },
            "selector": {
              "type": "string"
            },
            "js": {
              "type": "string"
            },
            "regex": {
              "type": "string"
            },
            "timeout": {
              "type": "number",
              "minimum": 0,
              "description": "ms, for this step (same as the step's own timeout)"
            }
          },
          "additionalProperties": false,
          "required": [
            "var"
          ]
        },
        "term.type": {
          "anyOf": [
            {
              "type": [
                "string",
                "number"
              ]
            },
            {
              "type": "object",
              "properties": {
                "text": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "cps": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "pane": {
                  "enum": [
                    1,
                    2
                  ],
                  "description": "2: the second terminal pane"
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ms, for this step (same as the step's own timeout)"
                }
              },
              "additionalProperties": false,
              "required": [
                "text"
              ]
            }
          ]
        },
        "term.print": {
          "anyOf": [
            {
              "type": [
                "string",
                "number"
              ]
            },
            {
              "type": "object",
              "properties": {
                "text": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "style": {
                  "enum": [
                    "out",
                    "err",
                    "prompt"
                  ]
                },
                "pane": {
                  "enum": [
                    1,
                    2
                  ],
                  "description": "2: the second terminal pane"
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ms, for this step (same as the step's own timeout)"
                }
              },
              "additionalProperties": false,
              "required": [
                "text"
              ]
            }
          ]
        },
        "term.clear": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "pane": {
                  "enum": [
                    1,
                    2
                  ],
                  "description": "2: the second terminal pane"
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ms, for this step (same as the step's own timeout)"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "term.run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "cmd": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    }
                  ]
                },
                "show": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "const": false
                    }
                  ]
                },
                "stdin": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "print": {
                  "enum": [
                    "both",
                    "stdout",
                    "stderr",
                    "none"
                  ]
                },
                "capture": {
                  "type": "object",
                  "properties": {
                    "var": {
                      "type": "string"
                    },
                    "regex": {
                      "type": "string"
                    },
                    "from": {
                      "enum": [
                        "stdout",
                        "stderr"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "var",
                    "regex"
                  ]
                },
                "background": {
                  "type": "boolean"
                },
                "id": {
                  "type": "string"
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                },
                "pane": {
                  "enum": [
                    1,
                    2
                  ],
                  "description": "2: the second terminal pane"
                },
                "allowFail": {
                  "type": "boolean"
                },
                "cps": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ms, for this step (same as the step's own timeout)"
                }
              },
              "additionalProperties": false,
              "required": [
                "cmd"
              ]
            }
          ]
        },
        "term.wait": {
          "type": "string",
          "description": "id of a background command"
        },
        "term.waitFor": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "regex": {
              "type": "string"
            },
            "var": {
              "type": "string"
            },
            "timeout": {
              "type": "number",
              "minimum": 0,
              "description": "ms, for this step (same as the step's own timeout)"
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "regex"
          ]
        },
        "term.kill": {
          "type": "string",
          "description": "id of a background command"
        },
        "clip": {
          "type": "object",
          "properties": {
            "take": {
              "type": "string"
            },
            "window": {
              "enum": [
                "browser",
                "term",
                "term2"
              ]
            },
            "from": {
              "type": "number",
              "minimum": 0
            },
            "to": {
              "type": "number",
              "minimum": 0
            },
            "speed": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "zoom": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "w": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "w"
              ]
            },
            "pan": {
              "type": "boolean"
            },
            "pointer": {
              "type": "boolean"
            },
            "title": {
              "type": "string"
            },
            "timeout": {
              "type": "number",
              "minimum": 0,
              "description": "ms, for this step (same as the step's own timeout)"
            }
          },
          "additionalProperties": false,
          "required": [
            "take",
            "from",
            "to"
          ],
          "description": "remix: a time range of one window of a kept take"
        },
        "timeout": {
          "type": "number",
          "minimum": 0,
          "description": "ms, for this step"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  }
}

{
  "name": "democast",
  "version": "0.1.0",
  "private": true,
  "description": "Record scripted demo videos of a live website and a real terminal, side by side.",
  "type": "module",
  "bin": {
    "democast": "src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "example": "node src/cli.js examples/tailground.yaml",
    "test": "node --test test/*.test.js",
    "test:update": "node --test --test-update-snapshots test/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "puppeteer-core": "^25.12.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "marked": "18.1.3",
    "typescript": "^5.9.3"
  }
}
